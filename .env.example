# ---------------------------------------------------------------------------
# Copia este archivo como .env y ajusta los valores que necesites.
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows)
# ---------------------------------------------------------------------------

# Entorno de ejecucion: development | production | testing
APP_ENV=development

# Clave de firma de Flask. OBLIGATORIO cambiarla en produccion.
SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# --- Servidor --------------------------------------------------------------
HOST=127.0.0.1
PORT=5000

# --- Descargas -------------------------------------------------------------
# Carpeta destino (absoluta o relativa a la raiz del proyecto).
DOWNLOAD_FOLDER=downloads

# Ruta al ejecutable de ffmpeg. Dejar vacio para buscarlo en el PATH.
# Windows: FFMPEG_LOCATION=C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_LOCATION=

# Calidad del MP3 en kbps: 128 | 192 | 256 | 320
AUDIO_QUALITY=192

# Duracion maxima permitida por video, en segundos (0 = sin limite).
MAX_DURATION_SECONDS=7200

# Timeout de red para yt-dlp, en segundos.
SOCKET_TIMEOUT=30

# Cantidad maxima de entradas guardadas en el historial.
HISTORY_LIMIT=100

# Pistas maximas que se descargan de una lista en una sola peticion.
PLAYLIST_MAX_ITEMS=50

# Pistas maximas que se muestran en la vista previa de una lista.
PLAYLIST_PREVIEW_ITEMS=200

# --- CORS ------------------------------------------------------------------
# Lista separada por comas. Usa * solo en desarrollo.
CORS_ORIGINS=*

# --- Logging ---------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Ruta de un archivo de log rotativo. Vacio = solo consola.
LOG_FILE=
